cleanup = true

params {
  out_dir             = './output'
  report_dir          = './reports'

  // Configs for the Sanger LSF cluster
  custom_config_base  = "https://raw.githubusercontent.com/nf-core/configs/master"
  images              = [[
    ['id': "run_id"],
    [
      "cycle1",
      "cycle2",
    ],
  ]]

  image_stack         = [[["id": "image_stack_id"], "image_stack.tif"]]

  chs_to_call_peaks   = [1, 2]

  codebook            = [["id": ''], "codebook.csv", "readouts.csv"]
  segmentation_method = "CELLPOSE"
  http_base_url       = "http://webatlas.cog.sanger.ac.uk/s3/"
}

profiles {
  local {
    process {
      executor = 'local'
      // Capture exit codes from upstream processes when piping
      shell    = ['/bin/bash', '-euo', 'pipefail']
    }
  }

  docker {
    docker.enabled      = true
    singularity.enabled = false
  }

  singularity {
    singularity.enabled      = true
    singularity.autoMounts   = true
    process.containerOptions = "--containall --cleanenv --no-mount /lib"
  }

  tiger {
    process {
      queue          = "inference"
      clusterOptions = { "-gpu 'num=1:gmem=20000:mode=shared'" }
    }
  }

  cub {
    process {
      queue          = "inference"
      clusterOptions = { "-gpu 'num=1:gmem=20000:mode=shared'" }
    }
  }
}

includeConfig 'conf/module.config'
// Load nf-core custom profiles from different Institutions
includeConfig "${params.custom_config_base}/nfcore_custom.config"

nextflow.enable.moduleBinaries = true

manifest {
  name         = "PaSTa"
  description  = "Pan-spatial transcriptomics analysis pipeline"
  author       = "Tong LI"
  version      = "0.2.0"
  contributors = ["Stanislaw Makarchuk", "Martin Prete"]
}

plugins {
  id 'nf-prov'
}

prov {
  enabled = true
  formats {
    bco {
      file      = 'bco.json'
      overwrite = true
    }
    wrroc {
      file      = 'ro-crate-metadata.json'
      overwrite = true
    }
  }
}

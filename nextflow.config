cleanup = true

params {
  out_dir = './output'
  report_dir = './reports'

  // Configs for the Sanger LSF cluster
  custom_config_base = "https://raw.githubusercontent.com/nf-core/configs/master"
}

profiles {
  local {
    process {
      executor = 'local'
      // Capture exit codes from upstream processes when piping
      shell = ['/bin/bash', '-euo', 'pipefail']
    }
  }

  docker {
    docker.enabled = true
    singularity.enabled = false
  }

  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    process.containerOptions = "--containall --cleanenv --no-mount /lib"
  }

  tiger {
    queue = "inference"
    clusterOptions = { "-gpu 'num=1:gmem=20000:mode=shared'" }
  }

  cub {
    queue = "inference"
    clusterOptions = { "-gpu 'num=1:gmem=20000:mode=shared'" }
  }
}

includeConfig 'conf/module.config'
// Load nf-core custom profiles from different Institutions
includeConfig "${params.custom_config_base}/nfcore_custom.config"

nextflow.enable.moduleBinaries = true

manifest {
  name = "PaSTa"
  description = "Pan-spatial transcriptomics analysis pipeline"
  author = "Tong LI"
  version = "0.1.1"
}

plugins {
  id 'nf-prov'
}

prov {
  enabled = true
  formats {
    bco {
      file = 'bco.json'
      overwrite = true
    }
    wrroc {
      file = 'ro-crate-metadata.json'
      overwrite = true
    }
  }
}

// params.modules_testdata_base_path = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/"
params.modules_testdata_base_path = "s3://spatial_demo_datasets/"

nextflow.enable.moduleBinaries = true

// Override the pipeline-wide `cleanup = true` (nextflow.config) for test runs:
// nf-test needs each task's work dir to still exist after a successful run so
// it can hash the outputs for snapshotting.
cleanup = false

docker.enabled = true

aws {
    region = "eu-west-2"
    client {
        endpoint = "https://cog.sanger.ac.uk"
        anonymous = true
        s3PathStyleAccess = true
    }
}

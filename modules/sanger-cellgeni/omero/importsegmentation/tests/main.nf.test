nextflow_process {

    name "Test Process OMERO_IMPORTSEGMENTATION"
    script "../main.nf"
    process "OMERO_IMPORTSEGMENTATION"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "omero"
    tag "omero/importsegmentation"

    test("importsegmentation - csv") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'path/to/omero/importsegmentation/example.csv', checkIfExists: true),
                    40882,
                    'wsi-omero-prod-02.internal.sanger.ac.uk',
                    'CellPose (diam 50) - standard morphology',
                    'CellPose (diam 50)',
                    '.',
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("importsegmentation - csv - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'path/to/omero/importsegmentation/example.csv', checkIfExists: true),
                    40882,
                    'wsi-omero-prod-02.internal.sanger.ac.uk',
                    'CellPose (diam 50) - standard morphology',
                    'CellPose (diam 50)',
                    '.',
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}

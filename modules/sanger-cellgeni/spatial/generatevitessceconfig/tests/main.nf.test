// nf-core modules test spatial/generatevitessceconfig
nextflow_process {

    name "Test Process SPATIAL_GENERATEVITESSCECONFIG"
    script "../main.nf"
    process "SPATIAL_GENERATEVITESSCECONFIG"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "spatial"
    tag "spatial/generatevitessceconfig"

    test("generateconfig - sdata") {

        when {
            process {
                """
                
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'spatialdata.sdata.zarr', checkIfExists: true),
                    'morphology_focus',
                    'cell_labels',
                    'table',
                    'https://webatlas.sanger.ac.uk/s3/'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("generateconfig - sdata - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'spatialdata.sdata.zarr', checkIfExists: true),
                    'morphology_focus',
                    'cell_labels',
                    'table',
                    'https://webatlas.sanger.ac.uk/s3/'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
